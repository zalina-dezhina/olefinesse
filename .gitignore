# environment / secrets — never commit these
.env
.env.local

# data exports / generated artifacts
*.xlsx
*.parquet   # time series data — never commit, always in Databricks Delta tables
*.pdf
*.docx

# output/ is tracked — PNG plots and summary CSVs go into git
# only exclude raw/aggregated data files inside output/
output/**/*.parquet

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/

# editor / IDE / OS cruft (IDE atomic-write temps, swaps, etc.)
*.tmp
*.tmp.*
*.swp
*~
.DS_Store
.vscode/

# Claude Code — keep shared settings.json trackable, ignore personal overrides
.claude/settings.local.json
