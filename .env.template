# Databricks connection — copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
#
# How to find these values:
#   DATABRICKS_HOST  : open Databricks in your browser → Settings → Developer → copy workspace URL
#   DATABRICKS_TOKEN : Settings → Developer → Access tokens → Generate new token
#   DDF_CLUSTER_ID   : in your terminal (once host+token are set): databricks clusters list
#                      look for the "research" cluster and copy its cluster_id

DATABRICKS_HOST=https://your-databricks-workspace-url
DATABRICKS_TOKEN=<your-personal-access-token>

# The running research cluster for this project (ephemeral — update when it changes)
DDF_CLUSTER_ID=<your-cluster-id>
